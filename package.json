{
  "name": "antd-storybook",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Ant Design 6.6.5 component docs (dumi) converted to Storybook. Source: github.com/ant-design/ant-design (MIT).",
  "scripts": {
    "convert": "node scripts/convert.mjs",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "convert:pages": "node scripts/convert-pages.mjs",
    "assets": "node scripts/make-assets.mjs",
    "check:brand": "node scripts/check-brand.mjs",
    "i18n:check": "node scripts/check-i18n.mjs",
    "test": "vitest run --project storybook",
    "test:a11y": "node scripts/test-a11y.mjs",
    "test:coverage": "vitest run --project storybook --coverage --coverage.include=src/**"
  },
  "dependencies": {
    "@ant-design/happy-work-theme": "^2.0.0",
    "@ant-design/icons": "^6.3.4",
    "@ant-design/plots": "^2.6.7",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@rc-component/util": "^1.13.0",
    "antd": "^6.6.5",
    "antd-img-crop": "~4.30.0",
    "antd-style": "^4.1.0",
    "antd-token-previewer": "^3.0.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "lodash": "^4.18.1",
    "lunar-typescript": "^1.8.6",
    "motion": "^13.4.6",
    "prismjs": "^1.30.0",
    "react": "^19.3.0",
    "react-countup": "^6.5.3",
    "react-dom": "^19.3.0",
    "react-draggable": "^4.7.2",
    "react-fast-marquee": "^1.6.5",
    "react-highlight-words": "^0.21.0",
    "react-icons": "^5.7.0",
    "react-infinite-scroll-component": "^7.2.1",
    "react-sticky-box": "^2.0.5",
    "runes2": "^1.1.10"
  },
  "overrides": {
    "source-map-js": "1.2.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@types/lodash": "^4.17.25",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-highlight-words": "^0.20.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "playwright": "latest",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.6.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.1",
    "vitest": "latest",
    "yaml": "^2.9.1",
    "@chromatic-com/storybook": "^5.5.1"
  }
}
